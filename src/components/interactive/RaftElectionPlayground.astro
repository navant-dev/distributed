<section class="interactive-lab" data-raft-lab aria-labelledby="raft-lab-title">
  <header><div><span class="lab-kicker">Interactive lab</span><h2 id="raft-lab-title">Raft election playground</h2></div><p>Advance terms, remove authority, and isolate a minority. Watch which nodes can participate in a majority election.</p></header>
  <div class="lab-grid">
    <div class="lab-controls"><div class="lab-button-row"><button type="button" data-election>Start election</button><button type="button" data-kill>Kill leader</button><button type="button" data-partition>Partition two nodes</button><button type="button" data-restore>Restore cluster</button></div><div class="term-display"><small>Current term</small><b data-term>1</b></div><div class="lab-findings" data-raft-status aria-live="polite">All five nodes are followers. Start an election.</div></div>
    <div class="lab-stage"><div class="raft-play-nodes" data-raft-nodes></div><div class="majority-line"><span>Majority required</span><b>3 of 5</b></div></div>
  </div>
  <noscript><p class="lab-noscript">Raft elects a leader with a majority. A partitioned minority cannot elect or commit, preserving one authoritative history.</p></noscript>
</section>
<script>
  const raftLab=document.querySelector('[data-raft-lab]');
  if(raftLab instanceof HTMLElement){type NodeState={alive:boolean;partitioned:boolean;role:'Follower'|'Candidate'|'Leader'};let term=1;let nodes:NodeState[]=Array.from({length:5},()=>({alive:true,partitioned:false,role:'Follower'}));
    const available=()=>nodes.map((node,index)=>({node,index})).filter(({node})=>node.alive&&!node.partitioned);const render=(message:string)=>{const root=raftLab.querySelector('[data-raft-nodes]')!;root.replaceChildren();nodes.forEach((node,index)=>{const card=document.createElement('div');card.className='raft-play-node';card.classList.toggle('leader',node.role==='Leader');card.classList.toggle('candidate',node.role==='Candidate');card.classList.toggle('offline',!node.alive);card.classList.toggle('partitioned',node.partitioned);const name=document.createElement('b');name.textContent=`Node ${index+1}`;const role=document.createElement('span');role.textContent=!node.alive?'Offline':node.partitioned?'Partitioned':node.role;const termLabel=document.createElement('small');termLabel.textContent=`term ${term}`;card.append(name,role,termLabel);root.append(card)});raftLab.querySelector('[data-term]')!.textContent=String(term);raftLab.querySelector('[data-raft-status]')!.textContent=message};
    const elect=()=>{term++;nodes.forEach(n=>{if(n.alive)n.role='Follower'});const voters=available();if(voters.length>=3){voters[0].node.role='Candidate';voters[0].node.role='Leader';render(`Node ${voters[0].index+1} received ${voters.length} votes and became leader.`)}else render(`Only ${voters.length} connected voters remain. No majority; the cluster cannot elect a leader.`)};
    raftLab.querySelector('[data-election]')?.addEventListener('click',elect);raftLab.querySelector('[data-kill]')?.addEventListener('click',()=>{const leader=nodes.findIndex(n=>n.role==='Leader');if(leader>=0){nodes[leader].alive=false;nodes[leader].role='Follower';render(`Node ${leader+1} stopped. The cluster has no leader until a new election.`)}else render('There is no current leader to stop.')});raftLab.querySelector('[data-partition]')?.addEventListener('click',()=>{nodes[3].partitioned=nodes[4].partitioned=true;nodes[3].role=nodes[4].role='Follower';render('Nodes 4 and 5 are isolated. The connected majority can continue; the minority cannot elect.')});raftLab.querySelector('[data-restore]')?.addEventListener('click',()=>{nodes=Array.from({length:5},()=>({alive:true,partitioned:false,role:'Follower'}));render('All nodes restored as followers. Start a new election.')});render('All five nodes are followers. Start an election.');}
</script>
