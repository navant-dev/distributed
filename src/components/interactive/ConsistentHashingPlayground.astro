<section class="interactive-lab" data-hash-lab aria-labelledby="hash-lab-title">
  <header><div><span class="lab-kicker">Interactive lab</span><h2 id="hash-lab-title">Consistent hashing playground</h2></div><p>Add and remove nodes to see which keys change owners. The ring uses deterministic positions so every change is explainable.</p></header>
  <div class="lab-grid hash-lab-grid">
    <div class="lab-controls"><div class="lab-button-row"><button type="button" data-add-node>Add node</button><button type="button" data-remove-node>Remove node</button><button type="button" data-add-key>Add key</button><button type="button" data-hash-reset>Reset</button></div><div class="lab-findings" data-movement aria-live="polite">Three nodes own eight keys.</div><ul class="assignment-list" data-assignments></ul></div>
    <div class="lab-stage"><div class="playground-ring" data-ring role="img" aria-label="Consistent hash ring with nodes and keys"></div><div class="ring-center"><b data-node-count>3 nodes</b><span data-key-count>8 keys</span></div></div>
  </div>
  <noscript><p class="lab-noscript">On a hash ring, each key belongs to the first node clockwise. A membership change moves only the neighboring range.</p></noscript>
</section>
<script>
  const hashLab=document.querySelector('[data-hash-lab]');
  if(hashLab instanceof HTMLElement){const palette=['#2476e5','#2b9a66','#7957c8','#f5a155','#d94a4a','#3ba6a0'];let nodeCount=3,keyCount=8;let previous=new Map<number,number>();
    const position=(seed:number)=>((seed*137)+41)%360;const owner=(key:number)=>{const keyPos=position(key+20);const nodes=Array.from({length:nodeCount},(_,i)=>({id:i,pos:position(i+1)})).sort((a,b)=>a.pos-b.pos);return (nodes.find(n=>n.pos>=keyPos)||nodes[0]).id};
    const place=(element:HTMLElement,degrees:number,radius:number)=>{const rad=(degrees-90)*Math.PI/180;element.style.left=`calc(50% + ${Math.cos(rad)*radius}px)`;element.style.top=`calc(50% + ${Math.sin(rad)*radius}px)`};
    const render=()=>{const ring=hashLab.querySelector('[data-ring]')!;ring.replaceChildren();const assignments=new Map<number,number>();for(let i=0;i<nodeCount;i++){const el=document.createElement('b');el.className='play-node';el.textContent=String.fromCharCode(65+i);el.style.background=palette[i];place(el,position(i+1),118);ring.append(el)}for(let k=1;k<=keyCount;k++){const own=owner(k);assignments.set(k,own);const el=document.createElement('i');el.className='play-key';el.textContent=String(k);el.style.borderColor=palette[own];if(previous.has(k)&&previous.get(k)!==own)el.classList.add('moved');place(el,position(k+20),88);ring.append(el)}const moved=[...assignments].filter(([k,v])=>previous.has(k)&&previous.get(k)!==v).length;hashLab.querySelector('[data-movement]')!.textContent=previous.size?`${moved} of ${keyCount} keys moved after the membership change.`:`${nodeCount} nodes own ${keyCount} keys.`;previous=assignments;hashLab.querySelector('[data-node-count]')!.textContent=`${nodeCount} nodes`;hashLab.querySelector('[data-key-count]')!.textContent=`${keyCount} keys`;const list=hashLab.querySelector('[data-assignments]')!;list.replaceChildren();for(let i=0;i<nodeCount;i++){const li=document.createElement('li');li.textContent=`Node ${String.fromCharCode(65+i)} · ${[...assignments.values()].filter(v=>v===i).length} keys`;list.append(li)}};
    hashLab.querySelector('[data-add-node]')?.addEventListener('click',()=>{if(nodeCount<6){nodeCount++;render()}});hashLab.querySelector('[data-remove-node]')?.addEventListener('click',()=>{if(nodeCount>2){nodeCount--;render()}});hashLab.querySelector('[data-add-key]')?.addEventListener('click',()=>{if(keyCount<16){keyCount++;render()}});hashLab.querySelector('[data-hash-reset]')?.addEventListener('click',()=>{nodeCount=3;keyCount=8;previous.clear();render()});render();}
</script>
