---
import { curriculum } from "@/data/navigation";
import { sitePath } from "@/utils/paths";
const { currentPath = "" } = Astro.props;
const liveCount = curriculum.reduce((total, section) => total + section.items.reduce((count, item) => count + (item.ready && item.href.startsWith("/topics/") ? 1 : 0), 0), 0);
---
<aside class="curriculum-sidebar" aria-label="Curriculum">
  <div class="sidebar-heading"><span>Curriculum</span><small>{liveCount} lessons</small></div>
  {curriculum.map((section) => (
    <section>
      <h2>{section.group}</h2>
      <ul>{section.items.map((item) => <li><a href={sitePath(item.href)} class:list={[currentPath === sitePath(item.href) && "active", !item.ready && "planned"]}><span>{item.label}</span>{item.ready ? <i aria-label="Available"></i> : <small>Soon</small>}</a></li>)}</ul>
    </section>
  ))}
  <div class="sidebar-progress"><div><span>Your progress</span><b data-progress-label>0%</b></div><progress value="0" max={liveCount} data-progress-bar>0 of {liveCount}</progress><a href={sitePath("/progress/")}>Bookmarks & history →</a><small>Stored only in this browser</small></div>
</aside>
