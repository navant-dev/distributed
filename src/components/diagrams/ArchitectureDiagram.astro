---
const { type } = Astro.props;
const labels: Record<string, [string, string]> = {
  fundamentals: ["Many machines. One product.", "Requests cross failure boundaries between clients, services, and state."],
  cap: ["Partition changes the rules", "A network break forces each operation to favor one truth or continued response."],
  pacelc: ["Failure choice. Normal-time choice.", "PACELC extends CAP with the latency-versus-consistency decision made every day."],
  consistency: ["A promise about visible history", "Different consistency models constrain which replica values a read may observe."],
  quorum: ["Overlap creates authority", "Read and write sets overlap when R + W is greater than N."],
  replication: ["Copy state across fault domains", "A leader streams committed changes to followers."],
  raft: ["One leader. One ordered log.", "A majority confirms one authoritative sequence."],
  "hash-ring": ["Only neighboring keys move", "Consistent hashing limits data movement when membership changes."],
  "two-phase": ["Prepare first. Decide second.", "The coordinator asks every participant before publishing one outcome."],
  lsm: ["Turn random writes into sequential work", "Memory absorbs writes; immutable tables are merged in the background."],
  "distributed-log": ["Append once. Read by offset.", "Ordered partitions let independent consumer groups replay durable events."],
  resilience: ["Retries need a control system", "Timeout, backoff, jitter, budgets, and load shedding keep failure local."],
};
const [caption, description] = labels[type] ?? ["System model", "A visual model of the concept."];
---
<figure class:list={["architecture-diagram", `diagram-${type}`]} role="img" aria-label={description}>
  <figcaption><span>{caption}</span><small>{description}</small></figcaption>

  {type === "fundamentals" && <div class="flow-chain"><b>Client</b><i>→</i><b>Service A</b><i>→</i><b>Service B</b><i>→</i><b class="state">State</b></div>}
  {type === "cap" && <div class="cap-visual"><div class="cap-node"><i>C</i><span>One truth</span></div><div class="partition-line"><b>NETWORK</b><em>PARTITION</em></div><div class="cap-node available"><i>A</i><span>Every response</span></div></div>}
  {type === "pacelc" && <div class="decision-visual"><div class="decision-root">Network state?</div><div class="decision-grid"><section><small>IF PARTITIONED</small><b>Consistency</b><i>or</i><b>Availability</b></section><section><small>ELSE</small><b>Consistency</b><i>or</i><b>Low latency</b></section></div></div>}
  {type === "consistency" && <div class="replica-timeline"><section><b>Write v2</b><i>→</i><span>Replica A · v2</span></section><section><em>propagation delay</em><i>⇢</i><span>Replica B · v1</span></section><section><small>What may a read return?</small><strong>Model decides</strong></section></div>}
  {type === "quorum" && <div class="quorum-visual"><div class="quorum-formula"><b>R + W &gt; N</b><span>N = 5 · R = 3 · W = 3</span></div><div class="quorum-nodes">{[1,2,3,4,5].map((n) => <span class:list={[n <= 3 && "read", n >= 3 && "write"]}>{n}</span>)}</div><p>Node 3 is the guaranteed overlap.</p></div>}
  {type === "replication" && <div class="replication-visual"><div class="diagram-box leader-box">Leader<small>accept writes</small></div><div class="diagram-arrow">replicate ↓</div><div class="replica-row"><div class="diagram-box">Follower A</div><div class="diagram-box">Follower B</div><div class="diagram-box">Follower C</div></div></div>}
  {type === "raft" && <div class="raft-visual"><div class="raft-node leader"><small>term 8</small><b>Leader</b><i>1 2 3 4</i></div><div class="raft-links"><span></span><span></span><span></span><span></span></div><div class="followers">{[1,2,3,4].map((n) => <div class="raft-node"><small>node {n}</small><b>Follower</b><i>1 2 3 <em>4</em></i></div>)}</div></div>}
  {type === "hash-ring" && <div class="ring-visual"><div class="hash-ring"><span class="ring-node rn1">A</span><span class="ring-node rn2">B</span><span class="ring-node rn3">C</span>{[1,2,3,4,5,6,7,8].map((n) => <i class={`key k${n}`}>{n}</i>)}</div><div class="ring-legend"><span><i></i>Node</span><span><i></i>Key</span><p>Add a node → move one slice, not every key.</p></div></div>}
  {type === "two-phase" && <div class="phase-visual"><div class="diagram-box leader-box">Coordinator</div><div class="phase-step"><span>1 · PREPARE</span><i>↓</i><span>2 · COMMIT / ABORT</span></div><div class="replica-row"><div class="diagram-box">Inventory<small>ready ✓</small></div><div class="diagram-box">Payment<small>ready ✓</small></div><div class="diagram-box">Ledger<small>ready ✓</small></div></div></div>}
  {type === "lsm" && <div class="storage-pipeline"><b>Write</b><i>→</i><b>WAL</b><i>→</i><b>Memtable</b><i>→ flush →</i><b class="state">SSTables</b><em>background compaction ↓</em><strong>Sorted levels</strong></div>}
  {type === "distributed-log" && <div class="log-visual"><div class="log-row"><b>P0</b>{[104,105,106,107].map(n=><span>{n}</span>)}</div><div class="log-row"><b>P1</b>{[81,82,83,84].map(n=><span>{n}</span>)}</div><div class="consumer-row"><span>Consumer group A · offset 106</span><span>Consumer group B · offset 82</span></div></div>}
  {type === "resilience" && <div class="resilience-flow">{["Timeout","Backoff","Jitter","Retry budget","Circuit breaker","Load shedding"].map((item, index)=><><b>{item}</b>{index < 5 && <i>→</i>}</>)}</div>}
</figure>
