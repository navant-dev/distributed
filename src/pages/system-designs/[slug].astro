---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { systemDesigns, type SystemDesign } from "@/data/system-designs";
import { systemDesignDetails } from "@/data/system-design-details";
import { sitePath } from "@/utils/paths";

export function getStaticPaths() {
  return systemDesigns.map((design) => ({ params: { slug: design.slug }, props: { design } }));
}
const { design } = Astro.props as { design: SystemDesign };
const detail = systemDesignDetails[design.slug];
---
<BaseLayout title={`${design.title} System Design — DistillSys`} description={design.description}>
  <main id="main-content" class="design-main">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href={sitePath("/")}>Home</a><span>/</span><a href={sitePath("/system-designs/")}>System designs</a><span>/</span><b>{design.title}</b></nav>
    <header class="design-hero"><div><span class="eyebrow">End-to-end walkthrough</span><h1>{design.title}</h1><p>{design.description}</p></div><aside><small>Reference scale</small><b>{design.scale}</b></aside></header>
    <nav class="design-jump" aria-label="On this page"><span>Jump to</span><a href="#requirements">Requirements</a><a href="#estimates">Estimates</a><a href="#architecture">Architecture</a><a href="#deep-dives">Deep dives</a><a href="#failures">Failures</a><a href="#interview">Interview</a></nav>
    <section class="design-section" id="requirements"><header><span>01</span><div><small>Frame before solving</small><h2>Requirements & boundaries</h2></div></header><div class="requirement-grid"><article><h3>Functional</h3><ul>{detail.scope.functional.map((item)=><li>{item}</li>)}</ul></article><article><h3>Quality attributes</h3><ul>{detail.scope.qualities.map((item)=><li>{item}</li>)}</ul></article><article><h3>Explicitly out of scope</h3><ul>{detail.scope.outOfScope.map((item)=><li>{item}</li>)}</ul></article></div></section>
    <section class="design-section" id="estimates"><header><span>02</span><div><small>Size the important constraints</small><h2>Back-of-the-envelope estimates</h2></div></header><div class="estimate-grid">{detail.estimates.map((estimate)=><article><small>{estimate.label}</small><strong>{estimate.value}</strong><p>{estimate.implication}</p></article>)}</div><p class="design-caveat">These are reference assumptions, not universal facts. In an interview or architecture review, change them when the product context changes.</p></section>
    <section class="design-section"><header><span>03</span><div><small>Define the contract</small><h2>API & data model</h2></div></header><div class="contract-grid"><div><h3>Core operations</h3>{detail.contracts.map((contract)=><article class="api-contract"><b>{contract.method}</b><code>{contract.path}</code><span>{contract.purpose}</span></article>)}</div><div><h3>Authoritative records</h3>{detail.dataModel.map((entity)=><article class="data-record"><b>{entity.entity}</b><code>{entity.fields}</code><span>{entity.note}</span></article>)}</div></div></section>
    <section class="design-flow" id="architecture" aria-labelledby="request-flow"><header><span>04</span><div><small>Trace the critical path</small><h2 id="request-flow">Architecture & request flow</h2></div></header><ol>{design.coreFlow.map((step,index)=><li><span>{index+1}</span><b>{step}</b>{index + 1 !== design.coreFlow.length ? <i aria-hidden="true">→</i> : null}</li>)}</ol><div class="component-grid">{design.components.map((component)=><article><h3>{component.name}</h3><p>{component.responsibility}</p></article>)}</div></section>
    <section class="design-section" id="deep-dives"><header><span>05</span><div><small>Reason about the hard parts</small><h2>Critical design deep dives</h2></div></header><div class="deep-dive-list">{detail.deepDives.map((deepDive)=><article><h3>{deepDive.title}</h3><p>{deepDive.content}</p><aside><b>Decision</b><span>{deepDive.decision}</span></aside></article>)}</div></section>
    <section class="design-section"><header><span>06</span><div><small>Make trade-offs explicit</small><h2>Architecture decisions</h2></div></header><div class="decision-table" role="table" aria-label="Architecture decisions"><div role="row"><b role="columnheader">Choice</b><b role="columnheader">Why</b><b role="columnheader">Cost</b></div>{design.decisions.map((decision)=><div role="row"><strong role="cell">{decision.choice}</strong><span role="cell">{decision.why}</span><span role="cell">{decision.cost}</span></div>)}</div></section>
    <section class="design-section" id="failures"><header><span>07</span><div><small>Failure-first review</small><h2>What happens if…?</h2></div></header><div class="design-failures">{design.failures.map((failure)=><article><h3>{failure.scenario}</h3><p>{failure.response}</p></article>)}</div></section>
    <section class="design-section"><header><span>08</span><div><small>Avoid premature complexity</small><h2>How the design evolves</h2></div></header><div class="evolution-list">{detail.evolution.map((step,index)=><article><span>{index+1}</span><div><small>{step.stage}</small><h3>{step.design}</h3><p><b>Move here when:</b> {step.trigger}</p></div></article>)}</div></section>
    <section class="design-section" id="interview"><header><span>09</span><div><small>Test the reasoning</small><h2>Interview follow-ups</h2></div></header><div class="design-questions">{detail.questions.map((item)=><details><summary>{item.question}<span aria-hidden="true">+</span></summary><p><b>Strong answer signal:</b> {item.signal}</p></details>)}</div></section>
    <section class="design-section"><header><span>10</span><div><small>Build from primitives</small><h2>Concepts used</h2></div></header><div class="design-concepts">{design.concepts.map((concept)=><a href={sitePath(concept.href)}>{concept.label}<span>Open refresher →</span></a>)}</div></section>
    <aside class="design-leader-lens"><span>Manager / architect lens</span><ul>{design.leaderLens.map((item)=><li>{item}</li>)}</ul></aside>
    <nav class="design-pagination" aria-label="System design navigation"><a href={sitePath("/system-designs/")}>← All system designs</a></nav>
  </main>
</BaseLayout>
