---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { scenarios, type Scenario } from "@/data/scenarios";
import { sitePath } from "@/utils/paths";
export function getStaticPaths(){ return scenarios.map((scenario)=>({params:{slug:scenario.slug},props:{scenario}})); }
const { scenario } = Astro.props as { scenario: Scenario };
const index = scenarios.findIndex((item)=>item.slug===scenario.slug);
const next = scenarios[(index+1)%scenarios.length];
---
<BaseLayout title={`${scenario.title} — Scenario Lab — DistillSys`} description={scenario.summary}>
  <main id="main-content" class="scenario-main" data-scenario-page={scenario.slug}>
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href={sitePath("/")}>Home</a><span>/</span><a href={sitePath("/scenarios/")}>Scenario Lab</a><span>/</span><b>{scenario.title}</b></nav>
    <header class="scenario-hero"><div><span class="eyebrow">{scenario.category} incident · {scenario.level}</span><h1>{scenario.title}</h1><p>{scenario.summary}</p></div><aside><small>Your role</small><b>{scenario.role}</b><small>Suggested time</small><b>{scenario.duration} minutes</b><button type="button" data-scenario-complete>Mark complete</button></aside></header>
    <nav class="scenario-jump" aria-label="On this page"><span>Incident flow</span><a href="#brief">Brief</a><a href="#evidence">Evidence</a><a href="#questions">Your response</a><a href="#model">Model response</a><a href="#score">Score</a></nav>
    <section class="scenario-section" id="brief"><header><span>01</span><div><small>Establish the operating contract</small><h2>Incident brief</h2></div></header><div class="scenario-brief"><article><small>Business impact</small><p>{scenario.context.business}</p></article><article><small>Current architecture</small><p>{scenario.context.architecture}</p></article><article class="scenario-invariant"><small>Protected invariant</small><p>{scenario.context.invariant}</p></article></div><div class="scenario-constraints"><b>Constraints</b><ul>{scenario.constraints.map((item)=><li>{item}</li>)}</ul></div></section>
    <section class="scenario-section" id="evidence"><header><span>02</span><div><small>Build a causal model</small><h2>Evidence timeline</h2></div></header><ol class="scenario-timeline">{scenario.signals.map((signal)=><li><time>{signal.time}</time><span></span><p>{signal.observation}</p></li>)}</ol><aside class="scenario-pause"><b>Pause before continuing</b><p>Write one sentence for the failure mechanism, one for the protected invariant, and one for the next piece of evidence you need.</p></aside></section>
    <section class="scenario-section" id="questions"><header><span>03</span><div><small>Reason before revealing</small><h2>Your response</h2></div></header><div class="scenario-prompts">{scenario.prompts.map((prompt,index)=><article><div><span>{index+1}</span><small>{prompt.phase}</small></div><h3>{prompt.question}</h3><details><summary>Need a nudge?<i aria-hidden="true">+</i></summary><p>{prompt.nudge}</p></details></article>)}</div></section>
    <section class="scenario-section" id="model"><header><span>04</span><div><small>Compare reasoning, not wording</small><h2>Model response</h2></div></header><details class="scenario-reveal"><summary>Reveal structured response <span aria-hidden="true">+</span></summary><div><article class="scenario-diagnosis"><small>Diagnosis</small><p>{scenario.response.diagnosis}</p></article><div class="scenario-actions"><article><small>Stabilize now</small><ol>{scenario.response.immediate.map((item)=><li>{item}</li>)}</ol></article><article><small>Recover safely</small><ol>{scenario.response.recovery.map((item)=><li>{item}</li>)}</ol></article><article><small>Prevent recurrence</small><ol>{scenario.response.prevention.map((item)=><li>{item}</li>)}</ol></article></div><aside><b>Trade-off</b><p>{scenario.response.tradeoffs}</p></aside></div></details></section>
    <section class="scenario-section" id="score"><header><span>05</span><div><small>Use evidence-based self-assessment</small><h2>10-point rubric</h2></div></header><div class="scenario-rubric">{scenario.rubric.map((item)=><label><input type="checkbox" value={item.points} data-rubric-item/><span><b>{item.dimension}</b><small>{item.strongSignal}</small></span><strong>+{item.points}</strong></label>)}</div><div class="scenario-score"><span>Your score</span><b data-rubric-score>0 / 10</b><p data-rubric-message>Check only the signals your answer demonstrated.</p></div><div class="scenario-traps"><b>Common traps</b><ul>{scenario.traps.map((trap)=><li>{trap}</li>)}</ul></div></section>
    <section class="scenario-section"><header><span>06</span><div><small>Strengthen the underlying concepts</small><h2>Related refreshers</h2></div></header><div class="design-concepts">{scenario.related.map((item)=><a href={sitePath(item.href)}>{item.label}<span>Open lesson →</span></a>)}</div></section>
    <nav class="scenario-pagination" aria-label="Scenario navigation"><a href={sitePath("/scenarios/")}>← All scenarios</a><a href={sitePath(`/scenarios/${next.slug}/`)}>Next: {next.title} →</a></nav>
  </main>
  <script>
    const page = document.querySelector('[data-scenario-page]');
    const slug = page?.getAttribute('data-scenario-page') ?? '';
    const complete = page?.querySelector('[data-scenario-complete]');
    const readCompleted = () => { try { return JSON.parse(localStorage.getItem('distillsys-scenarios') || '[]'); } catch { return []; } };
    const renderComplete = () => { const done=readCompleted().includes(slug); if(complete instanceof HTMLButtonElement){complete.classList.toggle('complete',done);complete.textContent=done?'Completed ✓':'Mark complete';complete.setAttribute('aria-pressed',String(done));} };
    complete?.addEventListener('click',()=>{ const completed=readCompleted(); const next=completed.includes(slug)?completed.filter((item:string)=>item!==slug):[...completed,slug]; try{localStorage.setItem('distillsys-scenarios',JSON.stringify(next));}catch{} renderComplete(); }); renderComplete();
    const rubric=[...(page?.querySelectorAll('[data-rubric-item]')??[])]; const score=page?.querySelector('[data-rubric-score]'); const message=page?.querySelector('[data-rubric-message]'); const updateScore=()=>{const total=rubric.reduce((sum,item)=>sum+(item instanceof HTMLInputElement&&item.checked?Number(item.value):0),0);if(score)score.textContent=`${total} / 10`;if(message)message.textContent=total>=9?'Excellent: your response protected the invariant and controlled recovery.':total>=7?'Strong: revisit the unchecked signals to make the response operationally complete.':total>=4?'Developing: strengthen the causal model and safe recovery sequence.':'Start with the invariant, failure mechanism, and first reversible mitigation.';};rubric.forEach((item)=>item.addEventListener('change',updateScore));
  </script>
</BaseLayout>
