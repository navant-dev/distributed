---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sitePath } from "@/utils/paths";
const featured = [
  { title:"RPC Deadlines", category:"Foundations", description:"Carry one shrinking time budget through the whole call graph.", href:"/topics/foundations/rpc-deadlines/", icon:"RPC", ready:true },
  { title:"Leases & Fencing", category:"Consensus", description:"Keep a paused former owner from corrupting shared state.", href:"/topics/consensus/leases-fencing/", icon:"F", ready:true },
  { title:"Transactional Outbox", category:"Transactions", description:"Commit business state and publish intent without a dual-write gap.", href:"/topics/transactions/transactional-outbox/", icon:"O", ready:true },
  { title:"Distributed Caching", category:"Storage", description:"Design freshness, invalidation, and cold-cache recovery explicitly.", href:"/topics/storage/distributed-caching/", icon:"C", ready:true },
  { title:"Schema Evolution", category:"Messaging", description:"Change event contracts while old code and historical replay coexist.", href:"/topics/messaging/schema-evolution/", icon:"S", ready:true },
  { title:"Cell Architecture", category:"Architecture", description:"Scale through repeatable slices with bounded tenant blast radius.", href:"/topics/architecture/cell-based-architecture/", icon:"▦", ready:true },
];
const paths = [
  {n:"01",title:"Foundations",text:"Refresh the primitives: failure, time, consistency, replication, and scale.",href:"/roadmap/#foundations",action:"Start the path"},
  {n:"02",title:"Interview Prep",text:"Practice the follow-up questions that distinguish senior-level reasoning.",href:"/interview/",action:"Practice questions"},
  {n:"03",title:"Architect Path",text:"Connect technical choices to invariants, risk, cost, and operations.",href:"/roadmap/#data-systems",action:"Explore architecture"},
  {n:"04",title:"Manager Path",text:"Review designs through failure impact, ownership, and decision quality.",href:"/interview/?level=manager#question-bank-title",action:"Open manager mode"},
];
---
<BaseLayout title="DistillSys — The 2026 Distributed Systems Field Guide" description="Modern visual refreshers, trade-offs, incident scenarios, research, and architecture reasoning for distributed systems engineers.">
  <main id="main-content" class="home-main">
    <section class="hero">
      <div class="hero-copy"><span class="eyebrow">The 2026 field guide for systems engineers</span><h1>See the system.<br/><span>Reason through failure.</span></h1><p>Forty-one concise concepts, complete architectures, incident scenarios, and current industry research—organized for the decisions engineers make in production.</p><div class="hero-buttons"><a class="btn btn-primary" href={sitePath("/roadmap/")}>Start the roadmap <span>→</span></a><a class="btn btn-secondary" href={sitePath("/scenarios/")}>Practice an incident</a></div><div class="hero-proof" aria-label="Library summary"><span><b>41</b> concepts</span><span><b>12</b> system designs</span><span><b>8</b> incident drills</span></div></div>
      <div class="hero-topology" role="img" aria-label="Clients connect through a load balancer to services, then fan out to a database, cache, and queue"><div class="topology-frame"><header><span>Live architecture map</span><i>Healthy</i></header><div class="topology"><div class="topology-row"><div class="topology-node"><b>Clients</b><small>request</small></div><i>→</i><div class="topology-node accent"><b>Load balancer</b><small>route</small></div><i>→</i><div class="topology-node accent"><b>Services</b><small>compute</small></div></div><div class="topology-down">↓</div><div class="topology-data"><div class="topology-node state"><b>Database</b><small>durable state</small></div><div class="topology-node cache"><b>Cache</b><small>fast reads</small></div><div class="topology-node queue"><b>Queue</b><small>async work</small></div></div></div><footer><span>p99 latency</span><b>84 ms</b><span>availability</span><b>99.99%</b></footer></div></div>
    </section>
    <section class="audience-banner"><b>Built for production reasoning.</b><p>Refresh a concept, challenge a design, investigate an incident, or prepare your team for the next failure mode.</p></section>
    <section class="home-section" id="featured"><header class="section-head"><div><span class="eyebrow">Start with the decisions that matter</span><h2>Featured topics</h2></div><p>Each visual one-pager moves from intuition to mechanics, trade-offs, failure scenarios, and real-world implications.</p></header><div class="featured-grid">{featured.map((topic) => <article class:list={["topic-card",!topic.ready&&"planned"]}><div class="topic-card-top"><span>{topic.category}</span><span>{topic.ready?"Live":"Coming soon"}</span></div><div class="topic-card-icon"><span>{topic.icon}</span></div><h3>{topic.title}</h3><p>{topic.description}</p>{topic.ready?<a href={sitePath(topic.href!)}>Open refresher →</a>:<span>On the roadmap</span>}</article>)}</div></section>
    <section class="home-section alt"><header class="section-head"><div><span class="eyebrow">Choose your depth</span><h2>Learning paths</h2></div><p>The same concepts, organized around what you need to do next.</p></header><div class="path-grid">{paths.map((path)=><a class="path-card" href={sitePath(path.href)}><span>{path.n}</span><h3>{path.title}</h3><p>{path.text}</p><b>{path.action} →</b></a>)}</div></section>
    <section class="home-section"><div class="coming-soon"><div><span>Architecture library</span><h2>Twelve complete system design walkthroughs.</h2><p>Trace requests, examine architecture decisions, pressure-test failures, and connect each design back to its core concepts.</p></div><a class="btn btn-secondary" href={sitePath("/system-designs/")}>Explore system designs →</a></div></section>
  </main>
</BaseLayout>
