---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sitePath } from "@/utils/paths";
const stages = [
  {n:"01",label:"Begin here",title:"Foundations",id:"foundations",topics:[{name:"Distributed systems",href:"/topics/foundations/distributed-systems/"},{name:"CAP theorem",href:"/topics/consistency/cap-theorem/"},{name:"PACELC",href:"/topics/consistency/pacelc/"},{name:"Consistency models",href:"/topics/consistency/consistency-models/"},{name:"Time & ordering",id:"time-ordering"}]},
  {n:"02",label:"Build authority",title:"Replication & consensus",id:"replication",topics:[{name:"Replication",href:"/topics/replication/replication/"},{name:"Quorums",href:"/topics/consensus/quorums/"},{name:"Raft consensus",href:"/topics/consensus/raft/"},{name:"Leader election"}]},
  {n:"03",label:"Distribute data",title:"Partitioning",id:"partitioning",topics:[{name:"Consistent hashing",href:"/topics/partitioning/consistent-hashing/"},{name:"Range partitioning"},{name:"Rebalancing"},{name:"Hot partitions"}]},
  {n:"04",label:"Coordinate change",title:"Transactions",id:"transactions",topics:[{name:"Two-phase commit",href:"/topics/transactions/two-phase-commit/"},{name:"Saga"},{name:"MVCC"},{name:"Idempotent workflows"}]},
  {n:"05",label:"Build data systems",title:"Databases & storage",id:"data-systems",topics:[{name:"LSM trees",href:"/topics/storage/lsm-trees/"},{name:"Distributed databases"},{name:"Compaction"},{name:"Distributed SQL"}]},
  {n:"06",label:"Move information",title:"Messaging",id:"messaging",topics:[{name:"Kafka / distributed logs",href:"/topics/messaging/distributed-logs/"},{name:"Delivery semantics"},{name:"Consumer groups"},{name:"Backpressure"}]},
  {n:"07",label:"Survive reality",title:"Reliability",id:"reliability",topics:[{name:"Failure & retry patterns",href:"/topics/reliability/failure-retry-patterns/"},{name:"Partial failures"},{name:"Circuit breakers"},{name:"Load shedding"}]},
  {n:"08",label:"Operate globally",title:"Multi-region",id:"multi-region",topics:[{name:"Active / active"},{name:"Geo replication"},{name:"RPO & RTO"},{name:"Conflict resolution"}]},
];
---
<BaseLayout title="Learning Roadmap — DistillSys" description="A practical learning roadmap for distributed systems engineers, architects, and engineering leaders."><main id="main-content" class="roadmap-main"><header class="roadmap-hero"><span class="eyebrow">A curriculum built around dependency</span><h1>Learn in the order systems become difficult.</h1><p>Start with failure, time, and consistency. Then layer in authority, data distribution, coordination, and operations.</p></header><aside class="roadmap-note"><b>How to use this</b><span>Twelve blue nodes are live. Everything else is deliberately sequenced for future releases.</span></aside><div class="roadmap-flow">{stages.map((stage)=><section class="roadmap-stage" id={stage.id}><div class="stage-number">{stage.n}</div><div class="stage-title"><small>{stage.label}</small><h2>{stage.title}</h2></div><div class="stage-topics">{stage.topics.map((topic)=>(topic.href?<a href={sitePath(topic.href)}>{topic.name} →</a>:<span id={"id" in topic ? topic.id : undefined}>{topic.name}</span>))}</div></section>)}</div></main></BaseLayout>
