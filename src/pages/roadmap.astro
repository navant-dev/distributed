---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sitePath } from "@/utils/paths";
import { roadmapStages } from "@/data/roadmap";
---
<BaseLayout title="Learning Roadmap — DistillSys" description="A practical 2026 learning roadmap for distributed systems engineers, architects, and engineering leaders.">
  <main id="main-content" class="roadmap-main">
    <header class="roadmap-hero"><span class="eyebrow">2026 curriculum · built around real dependencies</span><h1>Learn in the order systems become difficult.</h1><p>Start with uncertainty and time. Build authority, distribute data, coordinate change, survive overload, and finally operate across regions and failure domains.</p></header>
    <aside class="roadmap-note"><b>How to use this edition</b><span>All 41 lessons are live. Follow the sequence for durable foundations, or jump directly to the production decision in front of you.</span></aside>
    <div class="roadmap-flow">{roadmapStages.map((stage)=><section class="roadmap-stage" id={stage.id}><div class="stage-number">{stage.n}</div><div class="stage-title"><small>{stage.label}</small><h2>{stage.title}</h2></div><div class="stage-topics">{stage.topics.map((topic)=><a href={sitePath(topic.href)}>{topic.name} →</a>)}</div></section>)}</div>
  </main>
</BaseLayout>
