---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sitePath } from "@/utils/paths";
const stages = [
  {n:"01",label:"Begin here",title:"Foundations",id:"foundations",topics:[{name:"CAP theorem",href:"/topics/consistency/cap-theorem/"},{name:"Distributed systems"},{name:"Consistency models"},{name:"Time & ordering",id:"time-ordering"}]},
  {n:"02",label:"Build authority",title:"Replication & consensus",id:"replication",topics:[{name:"Raft consensus",href:"/topics/consensus/raft/"},{name:"Replication"},{name:"Quorums"},{name:"Leader election"}]},
  {n:"03",label:"Distribute data",title:"Partitioning",id:"partitioning",topics:[{name:"Consistent hashing",href:"/topics/partitioning/consistent-hashing/"},{name:"Range partitioning"},{name:"Rebalancing"},{name:"Hot partitions"}]},
  {n:"04",label:"Coordinate change",title:"Transactions",id:"transactions",topics:[{name:"Two-phase commit"},{name:"Saga"},{name:"MVCC"},{name:"Idempotent workflows"}]},
  {n:"05",label:"Build data systems",title:"Databases & storage",id:"data-systems",topics:[{name:"Distributed databases"},{name:"LSM trees"},{name:"Compaction"},{name:"Distributed SQL"}]},
  {n:"06",label:"Move information",title:"Messaging",id:"messaging",topics:[{name:"Distributed logs"},{name:"Kafka"},{name:"Delivery semantics"},{name:"Backpressure"}]},
  {n:"07",label:"Survive reality",title:"Reliability",id:"reliability",topics:[{name:"Partial failures"},{name:"Retry storms"},{name:"Circuit breakers"},{name:"Load shedding"}]},
  {n:"08",label:"Operate globally",title:"Multi-region",id:"multi-region",topics:[{name:"Active / active"},{name:"Geo replication"},{name:"RPO & RTO"},{name:"Conflict resolution"}]},
];
---
<BaseLayout title="Learning Roadmap — DistillSys" description="A practical learning roadmap for distributed systems engineers, architects, and engineering leaders."><main id="main-content" class="roadmap-main"><header class="roadmap-hero"><span class="eyebrow">A curriculum built around dependency</span><h1>Learn in the order systems become difficult.</h1><p>Start with failure, time, and consistency. Then layer in authority, data distribution, coordination, and operations.</p></header><aside class="roadmap-note"><b>How to use this</b><span>Blue nodes are live now. Everything else is deliberately sequenced for future releases.</span></aside><div class="roadmap-flow">{stages.map((stage)=><section class="roadmap-stage" id={stage.id}><div class="stage-number">{stage.n}</div><div class="stage-title"><small>{stage.label}</small><h2>{stage.title}</h2></div><div class="stage-topics">{stage.topics.map((topic)=>(topic.href?<a href={sitePath(topic.href)}>{topic.name} →</a>:<span id={topic.id}>{topic.name}</span>))}</div></section>)}</div></main></BaseLayout>
