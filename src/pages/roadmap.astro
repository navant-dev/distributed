---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sitePath } from "@/utils/paths";
import { roadmapStages } from "@/data/roadmap";
---
<BaseLayout title="Learning Roadmap — DistillSys" description="A practical learning roadmap for distributed systems engineers, architects, and engineering leaders."><main id="main-content" class="roadmap-main"><header class="roadmap-hero"><span class="eyebrow">A curriculum built around dependency</span><h1>Learn in the order systems become difficult.</h1><p>Start with failure, time, and consistency. Then layer in authority, data distribution, coordination, and operations.</p></header><aside class="roadmap-note"><b>How to use this</b><span>All 33 lessons are live. Follow the sequence or jump directly to the decision you need to make.</span></aside><div class="roadmap-flow">{roadmapStages.map((stage)=><section class="roadmap-stage" id={stage.id}><div class="stage-number">{stage.n}</div><div class="stage-title"><small>{stage.label}</small><h2>{stage.title}</h2></div><div class="stage-topics">{stage.topics.map((topic)=><a href={sitePath(topic.href)}>{topic.name} →</a>)}</div></section>)}</div></main></BaseLayout>
