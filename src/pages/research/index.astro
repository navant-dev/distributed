---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ResearchArchive from "@/components/research/ResearchArchive.astro";
import { researchAreas, researchPapers } from "@/data/research-papers";
import { sitePath } from "@/utils/paths";
---
<BaseLayout title="Research Papers — DistillSys" description="A static, curated index of recent systems and AI research papers organized by area and publication year.">
  <main id="main-content" class="research-main"><header class="research-hero"><span class="eyebrow">Research index · 2024–2026</span><h1>Track the ideas<br/>shaping systems.</h1><p>A curated starting point for recent work in distributed systems, cloud computing, databases, storage systems, and artificial intelligence—with a dedicated emphasis on research from industry labs. Every entry links to its source abstract and paper.</p><div><b>{researchPapers.length}</b><span>papers</span><b>{researchPapers.filter((paper)=>paper.industry?.length).length}</b><span>industry papers</span><b>{researchAreas.length}</b><span>research areas</span></div></header><nav class="research-area-nav" aria-label="Research areas">{researchAreas.map((area)=><a href={sitePath(`/research/${area.id}/`)}><span>{area.name}</span><small>{researchPapers.filter((paper)=>paper.area===area.id).length} papers →</small></a>)}</nav><aside class="research-note"><b>Curated industry research</b><p>Each area now includes at least 25 recent papers with recognized company or industry-lab affiliations. Selection favors reputable technical venues, relevance to practitioners, and citation signals. Counts are metadata snapshots, and preprints may not yet be peer reviewed. Last curated August 2026.</p></aside><ResearchArchive /></main>
</BaseLayout>
