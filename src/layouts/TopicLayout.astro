---
import BaseLayout from "./BaseLayout.astro";
import Sidebar from "@/components/layout/Sidebar.astro";
import ArchitectureDiagram from "@/components/diagrams/ArchitectureDiagram.astro";
import { sitePath } from "@/utils/paths";
const { title, description, category, difficulty, readingTime, tags, diagram, mentalModel, remember, slug, previous, next, relatedTopics = [] } = Astro.props;
---
<BaseLayout title={`${title} — DistillSys`} description={description}>
  <div class="docs-shell">
    <Sidebar currentPath={Astro.url.pathname} />
    <main id="main-content" class="topic-main">
      <article class="topic-article">
        <nav class="breadcrumb" aria-label="Breadcrumb"><a href={sitePath("/")}>Home</a><span>/</span><a href={sitePath("/roadmap/")}>{category}</a><span>/</span><b>{title}</b></nav>
        <header class="topic-hero">
          <div class="topic-meta"><span>{category}</span><span>{difficulty}</span><span>{readingTime} min read</span></div>
          <h1>{title}</h1><p>{description}</p>
          <div class="topic-actions"><button class="read-button" type="button" data-mark-read data-slug={slug}><span aria-hidden="true">✓</span> <span data-read-copy>Mark as read</span></button><button class="read-button" type="button" data-bookmark data-slug={slug}><span aria-hidden="true">◇</span> <span data-bookmark-copy>Bookmark</span></button><span>2–5 minute refresher</span></div>
        </header>
        <ArchitectureDiagram type={diagram} />
        <section class="mental-model"><span>Mental model</span><p>{mentalModel}</p></section>
        <div class="mdx-content"><slot /></div>
        <aside class="remember-this"><span>Remember this</span><p>{remember}</p></aside>
        <div class="topic-tags">{tags.map((tag: string) => <span>#{tag}</span>)}</div>
        {relatedTopics.length > 0 && <section class="related-topics"><span class="eyebrow">Continue the idea</span><h2>Related topics</h2><div>{relatedTopics.map((topic: any) => <a href={sitePath(`/topics/${topic.id}/`)}><small>{topic.data.category}</small><b>{topic.data.title}</b><span>Read next →</span></a>)}</div></section>}
        <nav class="topic-pagination" aria-label="Topic pagination">
          {previous ? <a href={sitePath(`/topics/${previous.id}/`)}><small>← Previous</small><b>{previous.data.title}</b></a> : <span></span>}
          {next ? <a href={sitePath(`/topics/${next.id}/`)}><small>Next →</small><b>{next.data.title}</b></a> : <span></span>}
        </nav>
      </article>
    </main>
  </div>
  <script>
    const button = document.querySelector('[data-mark-read]');
    if (button instanceof HTMLButtonElement) {
      const slug = button.dataset.slug; let read = JSON.parse(localStorage.getItem('distillsys-read') || '[]');
      const render = () => { const done = read.includes(slug); button.classList.toggle('completed', done); const copy = button.querySelector('[data-read-copy]'); if (copy) copy.textContent = done ? 'Completed' : 'Mark as read'; };
      render(); button.addEventListener('click', () => { read = read.includes(slug) ? read.filter((item: string) => item !== slug) : [...read, slug]; localStorage.setItem('distillsys-read', JSON.stringify(read)); render(); window.dispatchEvent(new CustomEvent('distillsys-progress')); });
    }
    const bookmark = document.querySelector('[data-bookmark]');
    if (bookmark instanceof HTMLButtonElement) {
      const slug = bookmark.dataset.slug; let bookmarks = JSON.parse(localStorage.getItem('distillsys-bookmarks') || '[]');
      const renderBookmark = () => { const saved = bookmarks.includes(slug); bookmark.classList.toggle('completed', saved); const copy = bookmark.querySelector('[data-bookmark-copy]'); if (copy) copy.textContent = saved ? 'Bookmarked' : 'Bookmark'; };
      renderBookmark(); bookmark.addEventListener('click', () => { bookmarks = bookmarks.includes(slug) ? bookmarks.filter((item: string) => item !== slug) : [...bookmarks, slug]; localStorage.setItem('distillsys-bookmarks', JSON.stringify(bookmarks)); renderBookmark(); });
    }
    const recentSlug = document.querySelector('[data-mark-read]')?.getAttribute('data-slug');
    if (recentSlug) { const recent = JSON.parse(localStorage.getItem('distillsys-recent') || '[]').filter((item: string) => item !== recentSlug); localStorage.setItem('distillsys-recent', JSON.stringify([recentSlug, ...recent].slice(0, 8))); }
  </script>
</BaseLayout>
